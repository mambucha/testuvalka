# Caddy сам отримає і оновлюватиме HTTPS-сертифікат для вашого домену.
# Домен береться зі змінної DOMAIN (файл .env). Напр. DOMAIN=mytest.duckdns.org
{$DOMAIN} {
	encode gzip
	reverse_proxy app:8000
}

# --- Якщо домену НЕМАЄ (тільки IP) ---------------------------------------
# Let's Encrypt не видає сертифікат на «голий» IP, тож закоментуйте блок вище
# і розкоментуйте цей — сайт працюватиме по http:// без сертифіката:
#
# :80 {
# 	encode gzip
# 	reverse_proxy app:8000
# }
