# Скопіюйте у .env і задайте сталий секрет. .env у git НЕ комітити (п. 5.6).
# Зміна секрету змінює параметри всіх задач усіх студентів — при розгортанні
# не перегенеровувати.
TESTUVALKA_SECRET=change-me-to-a-long-random-constant

# БД. За замовчуванням SQLite у корені проєкту. У проді — Postgres:
# TESTUVALKA_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname
# TESTUVALKA_DATABASE_URL=sqlite:///./testuvalka.db

# Токен доступу до кабінету викладача (CSV-журнал, сигнали аномалій).
# Без нього кабінет вимкнено (503). Задайте довгий випадковий рядок.
TESTUVALKA_TEACHER_TOKEN=change-me-teacher-token

# Автозавантаження тестів на старті (upsert). Зручно для хостингу без шелу:
# оновити тести = git push -> редеплой. Порожньо -> тільки демо-тест.
TESTUVALKA_AUTOLOAD=tests.yaml

# Ліміт часу на оцінювання в підпроцесі, секунди (за замовчуванням 15).
# TESTUVALKA_GRADE_TIMEOUT=15
